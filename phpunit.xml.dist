<?xml version="1.0" encoding="UTF-8"?>
<!--
    Standalone suite for coolms/ooxml.

    The consuming application points its own testsuite at this same `tests/`
    directory, so one set of files runs from both places and the two cannot
    disagree about what passes.

    Note: no double hyphen anywhere in this comment. XML forbids it, and PHPUnit
    reports it as "Double hyphen within comment" with no file name attached.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         resolveDependencies="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true">
    <testsuites>
        <testsuite name="ooxml">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
